{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import", "node"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_"
			}
		]
	},
	"env": {
		"builtin": true,
		"node": true
	},
	"ignorePatterns": ["**/dist", "**/node_modules", "**/drizzle"]
}
