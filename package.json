{
	"name": "leek",
	"version": "1.0.0",
	"private": true,
	"description": "general purpose bot",
	"license": "GPL-3.0-only",
	"main": "dist/index.js",
	"scripts": {
		"prepare": "husky",
		"start": "node dist/index.js",
		"dev": "infisical run -- pnpm start | pino-pretty",
		"build": "tsc",
		"build:clean": "pnpm clean && pnpm build",
		"clean": "rm -rf dist",
		"clean:all": "pnpm clean && rm -rf node_modules",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"neat": "oxlint && oxfmt --check",
		"neat:fix": "oxlint --fix && oxfmt",
		"db:migrate": "infisical run --env=prod -- tsx scripts/migrate.ts",
		"db:migrate-dev": "infisical run -- tsx scripts/migrate.ts",
		"db:gen": "infisical run -- drizzle-kit generate"
	},
	"dependencies": {
		"@sapphire/decorators": "^6.1.0",
		"@sapphire/discord.js-utilities": "^7.3.0",
		"@sapphire/framework": "^5.2.1",
		"@sapphire/plugin-subcommands": "^7.0.1",
		"@sapphire/utilities": "^3.16.2",
		"discord.js": "^14.22.1",
		"drizzle-orm": "^0.44.5",
		"emoji-regex": "^10.5.0",
		"ms": "^2.1.3",
		"pg": "^8.12.0",
		"pino": "^9.10.0",
		"pino-loki": "^2.5.0"
	},
	"devDependencies": {
		"@sapphire/pieces": "^4.4.1",
		"@types/ms": "^2.1.0",
		"@types/node": "^24.5.2",
		"@types/pg": "^8.15.5",
		"drizzle-kit": "^0.31.4",
		"husky": "^9.0.11",
		"lint-staged": "^16.1.6",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"pino-pretty": "^13.1.1",
		"tsx": "^4.20.6",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,mts,cts}": [
			"oxlint --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.{json,jsonc,md,yml,yaml,toml}": "oxfmt --no-error-on-unmatched-pattern"
	},
	"volta": {
		"node": "24.3.0",
		"pnpm": "10.17.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
